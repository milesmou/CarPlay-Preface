# Local beta credentials and release signing (never commit)
.private/
*.jks
*.keystore
release-signing.properties

# Never commit credential containers or installable distribution artifacts.
*.pk8
*.p7b
*.p12
*.pfx
*.pem
*.key
*.apk
*.aab

# Reviewed experimental pair from the upstream public APK; all other credential rules still apply.
!/runtime-assets/offline-mfi/identity.pk8
!/runtime-assets/offline-mfi/certificate.p7b

# Owner-authorized public APK signing material.
!/signing/carplay-release.p12
